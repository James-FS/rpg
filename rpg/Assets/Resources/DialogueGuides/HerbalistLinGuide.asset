  acceptedResponse: "\u8C22\u8C22\u4F60\u613F\u610F\u5E2E\u5FD9\u3002\u68EE\u6797\u91CC\u6709\u72FC\uFF0C\u8FD9\u628A\u6728\u5251\u9001\u7ED9\u4F60\u9632\u8EAB\uFF0C\u5DF2\u7ECF\u653E\u8FDB\u4F60\u7684\u80CC\u5305\u4E86\u3002\u8BB0\u5F97\u5728\u80CC\u5305\u91CC\u88C5\u5907\u5B83\uFF0C\u518D\u53BB\u5BFB\u627E\u6708\u5149\u836F\u8349\u3002\u59D4\u6258\u7684\u76EE\u6807\u548C\u6570\u91CF\u53EF\u4EE5\u5728\u4EFB\u52A1\u91CC\u67E5\u770B\u3002"
