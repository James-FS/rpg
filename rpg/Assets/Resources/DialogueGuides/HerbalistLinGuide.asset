  availableGreeting: "\u4F60\u597D\uFF0C\u6211\u662F\u6797\u6D1B\uFF0C\u9547\u4E0A\u7684\u836F\u5E08\u3002\u6211\u7684\u5973\u513F\u75C5\u4E86\uFF0C\u6211\u6B63\u9700\u8981\u68EE\u6797\u91CC\u7684\u6708\u5149\u836F\u8349\u3002\u4F60\u613F\u610F\u542C\u542C\u8FD9\u4EF6\u4E8B\u5417\uFF1F"
  acceptedGreeting: "\u4F60\u56DE\u6765\u4E86\u3002\u6708\u5149\u836F\u8349\u627E\u5F97\u600E\u4E48\u6837\uFF1F\u51FA\u53D1\u524D\u82E5\u6709\u7591\u95EE\uFF0C\u5C3D\u7BA1\u95EE\u6211\u3002"
